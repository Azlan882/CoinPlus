<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Electric Blue Orbit Ring (centered at 54,54, radius 26) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,28 A26,26 0 1,1 53.99,28 Z"
        android:strokeColor="#19D3FF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.85" />

    <!-- 3 Glowing Cyan-Blue Orbit Nodes -->
    <!-- Top-Right Node (~1:30) -->
    <path
        android:fillColor="#2CE8FF"
        android:pathData="M72.0,35.3 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
    <!-- Middle-Left Node (~9:00) -->
    <path
        android:fillColor="#2CE8FF"
        android:pathData="M28.1,55.8 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" />
    <!-- Bottom-Right Node (~4:30) -->
    <path
        android:fillColor="#2CE8FF"
        android:pathData="M72.7,72.1 m-2.0,0 a2.0,2.0 0 1,0 4.0,0 a2.0,2.0 0 1,0 -4.0,0" />

    <!-- Metallic Gold Coin Outer Ring with Right-Side Gap -->
    <path
        android:fillColor="#00000000"
        android:pathData="M73.9,48.5 A20.2,20.2 0 1,0 74.1,52.0"
        android:strokeWidth="4.8"
        android:strokeLineCap="butt">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="34"
                android:endX="74"
                android:endY="74"
                android:type="linear">
                <item android:color="#FFF099" android:offset="0.0" />
                <item android:color="#FFD43B" android:offset="0.35" />
                <item android:color="#F59E0B" android:offset="0.75" />
                <item android:color="#D97706" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Metallic Gold Pulse Waveform -->
    <path
        android:fillColor="#00000000"
        android:pathData="M34.8,52.0 L42.4,52.0 L45.1,49.1 L47.9,56.1 L54.8,40.1 L58.6,59.7 L62.5,52.0 L76.2,52.0"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="35"
                android:startY="40"
                android:endX="75"
                android:endY="60"
                android:type="linear">
                <item android:color="#FFF59D" android:offset="0.0" />
                <item android:color="#FFD43B" android:offset="0.45" />
                <item android:color="#F59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
